# ============ CORE ============
LISTEN_ADDR=0.0.0.0:7777
FORK_IMAGE=ladoga-ctf:latest
INTERNAL_PORT=7777
FORK_TTL=1800
REAPER_INTERVAL=30
HANDSHAKE_TIMEOUT=30
HANDSHAKE_PROMPT=gate - введите e-mail участника:
STATE_DIR=/app/state
FORK_NETWORK=ladoga-net

# ============ LIMITS ============
TEAM_MAX_PER_10MIN=3
IP_MAX_PER_10MIN=5
MAX_CONCURRENT=100

# ============ RESOURCES ============
RESOURCE_THRESHOLD=0.90
METRICS_INTERVAL=5
MIN_FREE_RAM_MB=512
MIN_FREE_DISK_MB=2048

# ============ RESOLVE ============
# env | http
RESOLVE_MODE=env
RESOLVE_URL=http://auth:8080/resolve
HTTP_TIMEOUT=5

# формат: email:team_id:team_name;email2:team_id:team_name
USERS=alice@example.com:1:RedTeam;bob@example.com:1:RedTeam;carol@example.com:2:BlueTeam

# ============ FLAGS ============
STATIC_FLAG=
FLAG_MODE=file
FLAG_POOL=/app/state/flags.pool
FLAG_USED=/app/state/flags.used
FLAG_ASSIGNED=/app/state/flags.assigned
FLAG_ISSUE_TOKEN=change-me-flag-token
FLAG_HTTP_ADDR=0.0.0.0:7788

# ============ ADMIN ============
ADMIN_ADDR=0.0.0.0:7789
ADMIN_TOKEN=change-me-admin-token

# ============ VERIFY ============
VERIFY_URL=http://verify:8081
VERIFY_ADDR=0.0.0.0:8081
VERIFY_TOKEN=change-me-verify-token
GATEWAY_INTERNAL=http://gateway:7788

# ============ AUTH ============
AUTH_ADDR=0.0.0.0:8080
USERS_FILE=/app/auth-data/users.json
TEAMS_FILE=/app/auth-data/teams.json

# ============ SIM ============
SW_PASSWORD=Kr3st-SW-2408
FW_PASSWORD=Kr3st-FW-2408

# ============ DOCKER ============
DOCKER_EXTRA_ARGS=--memory 128m --memory-swap 128m --cpus 0.25 --pids-limit 64 --read-only --tmpfs /tmp:size=16m